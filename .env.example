# LLM Provider — set at least one
# DeepSeek (recommended — fast + affordable)
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-v4-flash
# Anthropic (Claude)
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-6

# Supabase (optional - falls back to in-memory storage)
SUPABASE_URL=
SUPABASE_ANON_KEY=

# Server
PORT=3000
